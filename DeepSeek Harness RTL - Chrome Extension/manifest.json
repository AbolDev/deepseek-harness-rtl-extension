{
  "manifest_version": 3,
  "name": "DeepSeek Harness RTL",
  "version": "1.0.0",
  "description": "Automatic right-to-left text support for the local DeepSeek Harness GUI, keeping English and code left-to-right.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" },
    "default_title": "DeepSeek Harness RTL"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
